{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@client/*": [
        "client/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@/*": [
        "client/src/*"
      ]
    }
  },
  "include": [
    "client/src/index.tsx",
    "client/src/types/global.d.ts",
    "shared/**/*"
  ]
}
